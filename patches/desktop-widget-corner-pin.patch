+    // Corner anchoring via native layer-shell anchors: the surface is anchored
+    // to a screen corner (e.g. right+bottom) with fixed margins, so the
+    // compositor keeps it glued to that corner across ANY output scale / DPR /
+    // geometry change — no coordinate recompute needed. Config keys (instance
+    // config, settable from plugin settings):
+    //   pinToCorner (bool)      - anchor to the bottom-right corner
+    //   cornerMargin (number)   - px margin from the corner (both axes)
+    //   positionAnchor (string) - advanced override: "free" | "topLeft" |
+    //                             "topRight" | "bottomLeft" | "bottomRight"
+    //   anchorMarginX/Y (real)  - per-axis margin overrides
+    readonly property string positionAnchor: {
+        const cfg = instanceData?.config ?? {};
+        if (cfg.positionAnchor !== undefined && cfg.positionAnchor !== "")
+            return cfg.positionAnchor;
+        return cfg.pinToCorner === true ? "bottomRight" : "free";
+    }
+    readonly property real anchorMarginX: {
+        const cfg = instanceData?.config ?? {};
+        return cfg.anchorMarginX ?? cfg.cornerMargin ?? 0;
